      "id": "0e0f6cf0-7a38-4a0b-8b9d-d8b259283a8b",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\nconst phone =\n  item.json.body?.phone ||\n  item.json.phone ||\n  item.json.body?.booking?.phone ||\n  '';\n\nconst message =\n  item.json.message ||\n  item.json.sms_message ||\n  '';\n\nconst tz =\n  item.json.body?.custom_field?.timezone ||\n  item.json.person_time_zone ||\n  item.json.body?.booking?.person_time_zone ||\n  'America/Los_Angeles';\n\n// texting window\nconst startHour = 9;   // 9:00 AM\nconst endHour = 19;    // 7:00 PM\n\nconst now = new Date();\n\nconst parts = new Intl.DateTimeFormat('en-US', {\n  timeZone: tz,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n}).formatToParts(now);\n\nconst get = (type) => parts.find(p => p.type === type)?.value;\n\nlet year = Number(get('year'));\nlet month = Number(get('month'));\nlet day = Number(get('day'));\nconst hour = Number(get('hour'));\n\nconst sendNow = !!phone && hour >= startHour && hour < endHour;\n\nfunction pad(n) {\n  return String(n).padStart(2, '0');\n}\n\nlet sendAtLocal = null;\n\nif (!sendNow) {\n  if (hour >= endHour) {\n    const temp = new Date(now.toLocaleString('en-US', { timeZone: tz }));\n    temp.setDate(temp.getDate() + 1);\n    year = temp.getFullYear();\n    month = temp.getMonth() + 1;\n    day = temp.getDate();\n  }\n\n  sendAtLocal = `${year}-${pad(month)}-${pad(day)} ${pad(startHour)}:00:00`;\n}\n\nitem.json.phone = phone;\nitem.json.message = message;\nitem.json.timezone = tz;\nitem.json.send_now = sendNow;\nitem.json.send_at_local = sendAtLocal;\n\nreturn [item];"
      },
