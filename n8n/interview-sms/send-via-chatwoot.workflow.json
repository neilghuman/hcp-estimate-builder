      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $json;\nlet phone = String(source.body?.phone || source.phone || '').replace(/[^\\d+]/g, '');\nif (/^\\d{10}$/.test(phone)) phone = '+1' + phone;\nelse if (/^1\\d{10}$/.test(phone)) phone = '+' + phone;\nif (!/^\\+[1-9]\\d{7,14}$/.test(phone)) throw new Error('Interview SMS requires a valid phone number');\nconst content = String(source.message || source.sms_message || '').trim();\nif (!content) throw new Error('Interview SMS content is empty');\nconst name = [source.body?.first_name, source.body?.last_name].filter(Boolean).join(' ') || phone;\nreturn {json:{phone,content,name,inbox_id:17,queue_id:source.Id ?? null}};"
      }
    },
