        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.data.to[0] }}\",\n  \"message\": \"{{ $json.data.text }}\",\n  \"direction\": \"{{ $json.data.direction }}\",\n  \"status\": \"{{ $json.data.status }}\",\n  \"timestamp\": \"{{$now}}\"\n}",
