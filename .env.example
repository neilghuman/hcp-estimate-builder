# --- Housecall Pro ---
# API key from HCP account settings (MAX/XL plan). Sent as: Authorization: Token <key>
HCP_API_KEY=

# --- Customer Engagement Platform (Sprint 0) ---
# The identity resolver is dry-run only until the production write gate is approved.
# Configure provider credentials only in the server-side .env; never expose them to the browser.
ENGAGEMENT_IDENTITY_WRITES_ENABLED=false
ENGAGEMENT_DEFAULT_PHONE_COUNTRY=US
ENGAGEMENT_HCP_SOURCE_ACCOUNT_ID=
# Dedicated server-to-server credential for /api/integrations/identity/*.
# Required even while the resolver is dry-run-only; never expose it to browser code.
ENGAGEMENT_API_KEY=
# Read-only EspoCRM adapter. Use a dedicated, least-privilege API user.
ENGAGEMENT_ESPOCRM_BASE_URL=https://crm.unitedservicesnorthwest.com
ENGAGEMENT_ESPOCRM_API_KEY=
# Separate create-only service key for the bounded Contact/link canary. Keep empty until approved.
ENGAGEMENT_ESPOCRM_WRITER_API_KEY=
# Full HCP reconciliation is an explicit, read-only operator action.
ENGAGEMENT_RECONCILIATION_ENABLED=false

# HCP money fields are integer minor units (cents). Keep true unless proven otherwise.
HCP_MONEY_IN_CENTS=true

# Default line-item kind when the sheet doesn't specify one.
DEFAULT_LINE_KIND=labor

# direct | n8n | auto
# - direct: app calls HCP API directly
# - n8n: app calls N8N_ESTIMATE_WEBHOOK_URL and n8n performs HCP create
# - auto: use n8n when webhook URL is set, else direct
ESTIMATE_CREATE_PROVIDER=direct

# n8n webhook URL that receives the estimate-create payload from this app.
# Example: http://10.0.10.102:5678/webhook/hcp-estimate-create
N8N_ESTIMATE_WEBHOOK_URL=

# Optional shared secret header sent as x-portal-secret to n8n webhook.
N8N_ESTIMATE_WEBHOOK_SECRET=

# Comma-separated customer IDs that should ALWAYS get [TEST] prefix, even when
# testMode is off in the UI. Use this for your designated sandbox customer(s).
FORCE_TEST_PREFIX_CUSTOMER_IDS=

# Short in-memory cache for faster customer lookup UX.
SEARCH_CACHE_TTL_MS=30000
CUSTOMER_CACHE_TTL_MS=60000

# Google Maps/Places API key for the Customer Intake street-address autocomplete (Customer Intake
# UI only; non-secret client key, but restrict it to your domain(s) in Google Cloud Console —
# include scopefoundry.test / your intake host, or autocomplete silently falls back to manual entry).
GOOGLE_MAPS_KEY=

# --- Database (Pricebook) ---
# Connect to Postgres to store extracted pricebook items (line items from existing estimates).
# For Docker: use container name as host (inside Docker network)
# For local dev: use localhost:5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scopefoundry
DB_USER=scopeuser
DB_PASSWORD=scopepass_dev

# --- Ollama (AI descriptions) ---
OLLAMA_API_BASE=http://10.0.10.102:11434
OLLAMA_MODEL=llama3.1:latest

# --- Server ---
# Port the portal listens on. Pick a high, non-obvious port.
PORT=8123

# Bind address. 127.0.0.1 = localhost only (use an SSH tunnel / Tailscale to reach it).
# 0.0.0.0 = reachable on the LAN (keep it firewalled from the internet).
HOST=127.0.0.1

# Optional HTTP Basic Auth gate (leave blank to disable). Recommended if HOST=0.0.0.0.
PORTAL_USER=
PORTAL_PASS=

# --- Chat Foundry (bulk messaging through Chatwoot) ---
# Dedicated Chatwoot token for Chat Foundry (do NOT reuse the general-purpose token in prod).
# For dev only, the existing token may be supplied here via env — never commit a real token.
CHAT_FOUNDRY_CHATWOOT_BASE_URL=https://chat.unitedservicesnorthwest.com
CHAT_FOUNDRY_CHATWOOT_API_TOKEN=
# Discover via GET /api/chat-foundry/accounts, then paste the ID here (do not hard-code in source).
CHAT_FOUNDRY_CHATWOOT_ACCOUNT_ID=

# Safety gate for all send/retry/pause/resume/cancel operations (added in later sprints).
CHAT_FOUNDRY_SEND_ENABLED=false
CHAT_FOUNDRY_MAX_CAMPAIGN_SIZE=500

# Outbound allowlist by Chatwoot INBOX ID (comma-separated) — only inboxes with a verified
# n8n outbound relay (SMS/Telnyx, Thumbtack). Names/channel types are NOT trusted. Any inbox
# not listed here is hard-skipped with a visible reason.
CHAT_FOUNDRY_ALLOWED_INBOX_IDS=

# Rate limiting (used by the bulk sender in a later sprint). Conservative defaults.
CHAT_FOUNDRY_BATCH_SIZE=25
CHAT_FOUNDRY_MESSAGES_PER_MINUTE=30
CHAT_FOUNDRY_MAX_RETRIES=3
CHAT_FOUNDRY_RETRY_DELAY=5000
CHAT_FOUNDRY_CONTACT_COOLDOWN_HOURS=24

# AI rewrite (Sprint 4). Preview-only — never sends. Falls back to OLLAMA_API_BASE/OLLAMA_MODEL
# above if these are unset. The first rewrite after the model goes idle may be slow (cold load).
CHAT_FOUNDRY_OLLAMA_BASE=
CHAT_FOUNDRY_REWRITE_MODEL=
CHAT_FOUNDRY_REWRITE_TIMEOUT_MS=45000


# --- Customer Intake: branded customer communications (SMS + email) ---
# After a successful intake submit, the customer gets a branded SMS (via the correct Chatwoot
# inbox for the selected tag) and a branded confirmation email. Brand mapping lives in
# src/brands.js; inbox IDs and email identity can be overridden here per deploy.
#
# Per-brand Chatwoot inbox override (KEY = TREES | LANDSCAPING | ROOFING | CONSTRUCTION |
# PRESSURE_WASHING | FIREWOOD). Defaults are set in src/brands.js.
# INTAKE_BRAND_LANDSCAPING_INBOX_ID=7
# INTAKE_BRAND_TREES_INBOX_ID=13
# INTAKE_BRAND_ROOFING_INBOX_ID=14
# INTAKE_BRAND_CONSTRUCTION_INBOX_ID=17
# INTAKE_BRAND_PRESSURE_WASHING_INBOX_ID=
# INTAKE_BRAND_FIREWOOD_INBOX_ID=
#
# Confirmation email (SMTP). Email is skipped (never fails the intake) until a host is set.
INTAKE_SMTP_HOST=
INTAKE_SMTP_PORT=587
INTAKE_SMTP_SECURE=false
INTAKE_SMTP_USER=
INTAKE_SMTP_PASS=
# From/Reply-To identity. Global fallback; override per brand with
# INTAKE_BRAND_<KEY>_EMAIL_FROM / INTAKE_BRAND_<KEY>_REPLY_TO. The From display name is the
# brand company name automatically.
INTAKE_EMAIL_FROM=
INTAKE_EMAIL_REPLY_TO=

# Internal sales notification (in addition to the customer SMS + email).
# To sales@<brand-domain>, From estimaterequest@<brand-domain> — both derived from the brand
# domain in src/brands.js. Override per brand or globally if needed:
# INTAKE_BRAND_<KEY>_SALES_EMAIL=   # recipient override (default sales@<domain>)
# INTAKE_BRAND_<KEY>_SALES_FROM=    # from override (default estimaterequest@<domain>)
# INTAKE_SALES_EMAIL=               # global fallback recipient
# INTAKE_SALES_FROM=                # global fallback from
